# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.test-users.json
/test-results/
/playwright-report/

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.production
.env.development
.env.staging

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP config (contains secrets)
.mcp.json

# Ralph loop state + admin audit artifacts (may contain screenshots of admin UI)
/.ralph/

# Watermark backfill backups (contain pre-mutation copies of user images)
/.watermark-backups/
.env*

# Responsive UI audit output (screenshots/contact sheets, regenerable via
# scripts/responsive-audit.mjs) and Playwright MCP scratch state
/responsive-audit/
/.playwright-mcp/

# Cursor local render-check scratch dumps + stale homepage snapshots
.cursor-local-render-check*.html
/.stale/

# Multi-session coordination: commit the protocol, ignore the live state
# (sessions/, locks/, messages.md are local scratch). See coordination/README.md
/coordination/*
!/coordination/README.md
