NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Controlled SMS rollout. In production these default to "off" if omitted.
# "qa" exposes and processes only users in SMS_QA_USER_IDS; "on" enables the
# corresponding module for every eligible account.
SMS_RENTAL_MODE=off
SMS_PRICE_DROP_MODE=off
SMS_QA_USER_IDS=

# SMS delivery via uBill.ge (C18). These are SUPABASE EDGE FUNCTION secrets
# (`supabase secrets set --project-ref <ref> ...`), read by sms-dispatch and
# sms-delivery-report — not by the Next.js app, so they do not go in DigitalOcean.
SMS_DELIVERY_ENABLED=false
# uBill company API key (my.ubill.ge → Settings → API details)
SMS_PROVIDER_API_KEY=
# Numeric uBill Brand ID of an APPROVED sender name ("MyBakuriani" = 1)
SMS_PROVIDER_BRAND_ID=
# Same random value as the "Callback key" field in the uBill API settings
SMS_PROVIDER_CALLBACK_KEY=
# Comma list of the ONLY numbers that may receive SMS; every other row fails.
# Keep it set on staging. Unset = everyone (prod only).
SMS_TEST_RECIPIENTS=

# Marks a DEPLOYED build so scripts/check-production-config.mjs's checks actually
# run (wired as `prebuild`). Set to exactly "production" or "staging" in
# DigitalOcean App Platform on mybakuriani-prod / mybakuriani-staging. It replaced
# the Vercel-era VERCEL_ENV marker, which does not exist on DO — which is why the
# guard silently no-opped on every deploy after the migration.
# Leave EMPTY locally: any other value (blank included) skips validation.
DEPLOY_ENV=

# Comma-separated, exact origins permitted to make cookie-authenticated API
# mutations. Production must include the exact NEXT_PUBLIC_SITE_URL origin; do
# not use wildcards, paths, or trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000

# OPTIONAL, all four. Leaving them unset is a supported configuration — do not
# make them required again (doing so failed the production build, and the
# fail-closed handling behind them had already 429'd every rate-limited route).
#
# Rate limiting works without Upstash: the shared store defaults to the app's own
# Postgres via the consume_rate_limit RPC. Set the two UPSTASH_* values only to
# move that store to Redis; src/lib/rateLimit.ts prefers it automatically.
#
# Turnstile bot-protection on anonymous contact reveals is enforced only when
# TURNSTILE_SECRET_KEY is set (src/lib/turnstile.ts:isTurnstileConfigured).
# Without it, reveals stay rate-limited by IP but are not challenged.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Server-only key for the homepage's live Bakuriani weather. Configure this in
# DigitalOcean App Platform on both mybakuriani-prod and mybakuriani-staging;
# do not expose it as NEXT_PUBLIC_*.
WEATHERAPI_API_KEY=your_weatherapi_key

# Server-only key for the homepage's live Tbilisi->Bakuriani road badge
# (real drive time + traffic status) — src/lib/road-condition/server.ts calls the
# Mapbox Directions API (mapbox/driving-traffic profile) server-side. Same token
# type as the Lux project (mapbox.com > Tokens, Directions read access is enough).
# Missing/invalid token degrades to the admin-set default card value, no error.
# Superseded the keyless FOSSGIS OSRM fetch, which had no traffic model at all.
# Request volume is bounded to ~144/day (ROAD_REVALIDATE_SECONDS = 10 min), well
# under any Mapbox plan's included Directions API quota.

# Public Mapbox token for the property-listing maps (src/components/maps/
# BakurianiMap.tsx, ExactLocationPicker.tsx) — Mapbox GL JS replaced Leaflet/
# CartoDB 2026-09-05. A "pk." token is designed for client exposure; this is a
# DIFFERENT env var from the server-only MAPBOX_ACCESS_TOKEN above (same
# underlying Mapbox account is fine, just don't collapse the two names).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Server-only key for src/lib/gemini.ts, consumed by the 3 admin-only AI-assist
# routes (blog draft, broadcast draft, review analysis). Never expose as
# NEXT_PUBLIC_*. Missing/invalid throws rather than degrading, so those routes
# 500 without it — that's expected for an admin-only feature, not a bug.
GEMINI_API_KEY=your_gemini_api_key

# Password for the qa-*@qa.mybakuriani.test accounts used by
# scripts/responsive-audit.mjs to log in as each role. Never hardcode this.
QA_TEST_PASSWORD=your_qa_test_password

# Optional — only for `npm run types:gen` / `npm run types:check`
# (scripts/gen-database-types.sh). A Supabase personal access token; the
# project id defaults to the ref in NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_ID=

# Optional — set to "true" to turn on the live Bakuriani ski-lift status card,
# which reads MTA's public status.mta.ski (see src/lib/ski-lifts/server.ts). Left
# unset the card shows its admin-editable values. Keep OFF until a live fetch of
# the three zones is verified — the source was down (backend deleted) as of
# 2026-09-23. Do NOT put "true" here or a copied .env.local activates it blind.
# SKI_LIFTS_ENABLED=

# Keepz card payments (contract C32) — server-only; NEVER prefix with NEXT_PUBLIC_.
# All five must be set or every payment route answers 503 (fail closed: no wallet
# is ever credited without a verified Keepz payment). Deliberately NOT required by
# scripts/check-production-config.mjs (C16: required-optional vars broke prod).
#   KEEPZ_ENV            test | production — selects the FIXED gateway base URL
#                        (gateway.dev.keepz.me vs gateway.keepz.me); there is no URL var.
#   KEEPZ_INTEGRATOR_ID  UUID issued by Keepz (sent as `identifier` and `integratorId`)
#   KEEPZ_RECEIVER_ID    UUID of the Keepz BRANCH that receives the money
#   KEEPZ_PUBLIC_KEY     Keepz's RSA public key, single-line base64 DER (SPKI)
#   KEEPZ_PRIVATE_KEY    OUR RSA private key, single-line base64 DER (PKCS#8). Generate
#                        it locally with openssl and write it here by script — never
#                        paste it anywhere. Keepz only ever receives our PUBLIC key.
# KEEPZ_RECONCILE_SECRET_SHA256 is the hex SHA-256 of the sweeper's Bearer secret;
# the secret itself lives only in Supabase Vault (app.keepz_reconcile_secret).
KEEPZ_ENV=
KEEPZ_INTEGRATOR_ID=
KEEPZ_RECEIVER_ID=
KEEPZ_PUBLIC_KEY=
KEEPZ_PRIVATE_KEY=
KEEPZ_RECONCILE_SECRET_SHA256=

# --- Email (C33) — all optional; unset means nothing is sent ---------------
# Resend sends notification emails and holds the Broadcast (marketing)
# contacts. Nothing is sent unless EMAIL_DELIVERY_ENABLED=true.
EMAIL_DELIVERY_ENABLED=
# Comma list of the ONLY addresses that may receive mail (staging).
# Unset = nothing is sent. "*" = everyone (prod only).
EMAIL_ALLOWED_RECIPIENTS=
# Notification emails per UTC day (default 80; Auth mail shares Resend's 100/day)
EMAIL_DAILY_CAP=
# FULL-ACCESS key (sending-only keys cannot manage contacts)
RESEND_API_KEY=
# Defaults to "MyBakuriani <no-reply@mybakuriani.ge>"
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# SHA-256 (hex) of the Vault secret app.email_dispatch_secret — see
# supabase/migrations/20260925160100_email_dispatch_schedule.sql
EMAIL_DISPATCH_SECRET_SHA256=
