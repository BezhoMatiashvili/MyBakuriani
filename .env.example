NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated, exact origins permitted to make cookie-authenticated API
# mutations. Production must include the exact NEXT_PUBLIC_SITE_URL origin; do
# not use wildcards, paths, or trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000

# Public contact reveals are anonymous but protected by invisible Cloudflare
# Turnstile and Upstash's distributed rate limiter. Set all four values in
# Vercel Production. Set them in Preview too when testing public contact there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Server-only key for the homepage's live Bakuriani weather. Configure this in
# Vercel for both Preview and Production; do not expose it as NEXT_PUBLIC_*.
WEATHERAPI_API_KEY=your_weatherapi_key

# Edge-function secrets for the live Tbilisi->Bakuriani road-condition badge.
# GOOGLE_MAPS_API_KEY: a Google Cloud key with the Routes API enabled (billing on).
# ROAD_CONDITION_SECRET: shared Bearer secret gating the road-condition-refresh
# edge function; must match `app.road_condition_secret` in the DB (see the
# 20260724130500_schedule_road_condition migration). Set both via
# `supabase secrets set` — they are NOT read by the Next.js runtime.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
ROAD_CONDITION_SECRET=your_road_condition_shared_secret

# Password for the qa-*@qa.mybakuriani.test accounts used by
# scripts/responsive-audit.mjs to log in as each role. Never hardcode this.
QA_TEST_PASSWORD=your_qa_test_password
