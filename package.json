{
  "name": "mybakuriani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-production-config.mjs && node scripts/i18n-scope.mjs --check && node scripts/check-message-parity.mjs",
    "i18n:parity": "node scripts/check-message-parity.mjs",
    "build": "next build",
    "i18n:scope": "node scripts/i18n-scope.mjs",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:public": "npx playwright test --project=public",
    "test:e2e:auth": "npx playwright test --project=auth",
    "test:e2e:setup": "npx playwright test --project=setup",
    "typecheck": "tsc --noEmit",
    "test:production-config": "node --test scripts/check-production-config.test.mjs",
    "security:secrets": "node scripts/check-secret-permissions.mjs",
    "security:audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "1.36.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.6.0",
    "next": "15.5.21",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@hono/node-server": "2.0.11",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
